  <div class="topbar topbar-admin">
    <a href="/admin" class="topbar-marca">
      <img class="logo-restaurante" src="<%= marca.logo %>" alt="Logo <%= marca.nome %>">
      <span><%= marca.nome %></span>
    </a>
    <nav class="admin-nav">
      <% if (usuario.ehGerente) { %>
        <a href="/admin">Dashboard</a>
        <a href="/admin/mesas">Mesas</a>
        <a href="/admin/cardapio">Cardápio</a>
        <a href="/admin/opcoes-padrao">Opções padrão</a>
      <% } %>
      <a href="/admin/pedidos">Pedidos</a>
      <% if (usuario.ehGerente) { %>
        <a href="/admin/usuarios">Usuários</a>
        <a href="/admin/config">Configuração</a>
      <% } %>
    </nav>
    <div class="topbar-usuario">
      <a href="/admin/minha-senha" title="Trocar minha senha"><%= usuario.nomeExibicao %> · <%= perfis[usuario.perfil] %></a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <button type="submit">Sair</button>
      </form>
    </div>
  </div>
