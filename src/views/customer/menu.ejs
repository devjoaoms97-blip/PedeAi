<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
  <title><%= marca.nome %> - Cardápio</title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/marca-estilo') %>
  <link rel="stylesheet" href="/css/cliente.css">
</head>
<body class="cliente">
  <header class="cliente-topo">
    <img class="logo-restaurante" src="<%= marca.logo %>" alt="Logo <%= marca.nome %>">
    <div class="cliente-topo-textos">
      <div class="cliente-topo-nome"><%= marca.nome %></div>
      <div class="cliente-topo-mesa">Você está na <strong><%= mesa.nome %></strong></div>
    </div>
    <%- include('../partials/botao-tema') %>
  </header>

  <div class="container" id="app">

    <div id="tela-home">
      <% if (categorias.length === 0) { %>
        <p>Nenhum item disponível no momento.</p>
      <% } else { %>
        <div class="grade-categorias">
          <% categorias.forEach(cat => { %>
            <button type="button" class="tile-categoria" data-abrir-categoria="<%= cat.id %>">
              <% if (cat.imagem) { %>
                <img class="icone" src="<%= cat.imagem %>" alt="<%= cat.nome %>">
              <% } else { %>
                <div class="icone-fallback"><%= cat.nome.charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="nome-categoria"><%= cat.nome %></div>
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% categorias.forEach(cat => { %>
      <div class="tela-categoria" data-categoria="<%= cat.id %>">
        <button type="button" class="btn-voltar" data-voltar-home>&larr; Todas as categorias</button>
        <h1 class="titulo-tela"><%= cat.nome %></h1>

        <% cat.itens.forEach(item => { %>
          <div class="item-linha" data-item-id="<%= item.id %>">
            <div class="item-info">
              <div class="item-nome"><%= item.nome %></div>
              <% if (item.descricao) { %><div class="item-desc"><%= item.descricao %></div><% } %>
              <div class="item-preco">R$ <%= item.preco.toFixed(2).replace('.', ',') %></div>
            </div>

            <div class="item-foto">
              <% if (item.imagem) { %>
                <img src="<%= item.imagem %>" alt="<%= item.nome %>">
              <% } else { %>
                <div class="item-foto-vazia">
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14l-1.6 16.2a2 2 0 0 1-2 1.8H8.6a2 2 0 0 1-2-1.8L5 3z"></path><path d="M5.6 9h12.8"></path></svg>
                </div>
              <% } %>
            </div>

            <div class="item-controles">
              <% if (item.grupos.length === 0) { %>
                <div class="qtd-control">
                  <button type="button" class="qtd-btn btn-menos" aria-label="Tirar um <%= item.nome %>">−</button>
                  <span class="qtd-valor">0</span>
                  <button type="button" class="qtd-btn btn-mais" aria-label="Adicionar um <%= item.nome %>">+</button>
                </div>
              <% } else { %>
                <button type="button" class="btn-secundario btn-abrir-modal">Adicionar</button>
              <% } %>
            </div>

            <% if (item.grupos.length > 0) { %>
              <div class="linhas-configuradas"></div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% }) %>

    <div class="tela-carrinho" id="tela-carrinho">
      <button type="button" class="btn-voltar" data-fechar-carrinho>&larr; Continuar escolhendo</button>
      <h1 class="titulo-tela">Seu carrinho</h1>
      <div class="card" id="carrinho-linhas"></div>
      <div class="carrinho-total">
        <span>Total</span>
        <span id="carrinho-total-valor">R$ 0,00</span>
      </div>
    </div>

  </div>

  <div class="footer-bar" id="footer-home">
    <button class="btn-primario" id="btn-ver-carrinho" disabled>Ver carrinho</button>
  </div>

  <div class="footer-bar" id="footer-carrinho" style="display:none;">
    <button class="btn-primario" id="btn-enviar" disabled>Fazer pedido</button>
  </div>

  <div class="modal-overlay" id="modal-overlay">
    <div class="modal-box">
      <h3 id="modal-titulo"></h3>
      <div id="modal-grupos"></div>
      <label>Observação (opcional)</label>
      <input type="text" id="modal-observacao" placeholder="Ex: sem canudo">
      <div class="qtd-control">
        <button type="button" class="qtd-btn btn-menos" id="modal-qtd-menos">−</button>
        <span class="qtd-valor" id="modal-qtd-valor">1</span>
        <button type="button" class="qtd-btn" id="modal-qtd-mais">+</button>
      </div>
      <button class="btn-primario" id="modal-confirmar">Adicionar ao pedido</button>
      <button class="btn-secundario" id="modal-cancelar">Cancelar</button>
    </div>
  </div>

  <script>
    const token = "<%= mesa.token %>";
    const itensComOpcoes = <%- JSON.stringify(categorias.flatMap(c => c.itens).filter(i => i.grupos.length > 0)) %>;
    const itensPorId = {};
    itensComOpcoes.forEach(it => (itensPorId[it.id] = it));

    // Preço/nome de TODOS os itens (com ou sem opções), pra calcular o total do carrinho.
    const todosItens = <%- JSON.stringify(categorias.flatMap(c => c.itens).map(i => ({ id: i.id, nome: i.nome, preco: i.preco }))) %>;
    const todosItensPorId = {};
    todosItens.forEach(it => (todosItensPorId[it.id] = it));

    function formatarReais(valor) {
      return 'R$ ' + valor.toFixed(2).replace('.', ',');
    }

    const simpleCarrinho = {};
    const opcoesCarrinho = [];
    let uidSeq = 1;

    document.querySelectorAll('[data-abrir-categoria]').forEach(tile => {
      tile.addEventListener('click', () => {
        document.getElementById('tela-home').style.display = 'none';
        document.querySelectorAll('.tela-categoria').forEach(t => t.classList.remove('ativa'));
        const alvo = document.querySelector(`.tela-categoria[data-categoria="${tile.dataset.abrirCategoria}"]`);
        if (alvo) alvo.classList.add('ativa');
        window.scrollTo(0, 0);
      });
    });

    document.querySelectorAll('[data-voltar-home]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tela-categoria').forEach(t => t.classList.remove('ativa'));
        document.getElementById('tela-home').style.display = '';
        window.scrollTo(0, 0);
      });
    });

    function totalItens() {
      const totalSimples = Object.values(simpleCarrinho).reduce((a, b) => a + b, 0);
      const totalOpcoes = opcoesCarrinho.reduce((a, l) => a + l.quantidade, 0);
      return totalSimples + totalOpcoes;
    }

    function valorTotalCarrinho() {
      let total = 0;
      Object.entries(simpleCarrinho).forEach(([itemId, qtd]) => {
        if (qtd > 0 && todosItensPorId[itemId]) total += todosItensPorId[itemId].preco * qtd;
      });
      opcoesCarrinho.forEach(l => {
        const it = todosItensPorId[l.item_id];
        if (it) total += it.preco * l.quantidade;
      });
      return total;
    }

    function atualizarBotaoEnviar() {
      const total = totalItens();
      const valor = valorTotalCarrinho();

      const btnCarrinho = document.getElementById('btn-ver-carrinho');
      btnCarrinho.disabled = total === 0;
      btnCarrinho.textContent = total === 0
        ? 'Ver carrinho'
        : `Ver carrinho (${total} ${total === 1 ? 'item' : 'itens'}) · ${formatarReais(valor)}`;

      const btnEnviar = document.getElementById('btn-enviar');
      btnEnviar.disabled = total === 0;
      btnEnviar.textContent = total === 0 ? 'Fazer pedido' : `Fazer pedido · ${formatarReais(valor)}`;

      if (document.getElementById('tela-carrinho').classList.contains('aberta')) {
        if (total === 0) fecharCarrinho();
        else renderizarCarrinho();
      }
    }

    function ajustarSimples(itemId, delta) {
      simpleCarrinho[itemId] = Math.max(0, (simpleCarrinho[itemId] || 0) + delta);
      const card = document.querySelector(`[data-item-id="${itemId}"]`);
      const valorEl = card && card.querySelector('.qtd-valor');
      if (valorEl) valorEl.textContent = simpleCarrinho[itemId];
      atualizarBotaoEnviar();
    }

    document.querySelectorAll('[data-item-id]').forEach(card => {
      const itemId = card.dataset.itemId;
      if (itensPorId[itemId]) return;
      const valorEl = card.querySelector('.qtd-valor');
      if (!valorEl) return;
      card.querySelector('.btn-mais').addEventListener('click', () => ajustarSimples(itemId, 1));
      card.querySelector('.btn-menos').addEventListener('click', () => ajustarSimples(itemId, -1));
    });

    const overlay = document.getElementById('modal-overlay');
    let itemAtual = null;
    let modalQtd = 1;

    document.querySelectorAll('.btn-abrir-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-item-id]');
        itemAtual = itensPorId[card.dataset.itemId];
        abrirModal();
      });
    });

    function abrirModal() {
      modalQtd = 1;
      document.getElementById('modal-qtd-valor').textContent = modalQtd;
      document.getElementById('modal-titulo').textContent = itemAtual.nome;
      document.getElementById('modal-observacao').value = '';

      const cont = document.getElementById('modal-grupos');
      cont.innerHTML = '';

      itemAtual.grupos.forEach(g => {
        const div = document.createElement('div');
        div.className = 'grupo-opcao';
        div.dataset.grupoId = g.id;
        div.dataset.tipo = g.tipo;

        const titulo = document.createElement('div');
        titulo.className = 'grupo-opcao-titulo';
        titulo.textContent = g.nome + ' ';
        if (g.obrigatorio) {
          const span = document.createElement('span');
          span.className = 'grupo-opcao-obrigatorio';
          span.textContent = '(obrigatório)';
          titulo.appendChild(span);
        }
        div.appendChild(titulo);

        if (g.tipo === 'quantidade') {
          const linha = document.createElement('div');
          linha.className = 'qtd-control';
          linha.innerHTML = `
            <button type="button" class="qtd-btn btn-menos grupo-menos">−</button>
            <span class="qtd-valor grupo-valor">${g.qtd_min}</span>
            <button type="button" class="qtd-btn grupo-mais">+</button>
          `;
          div.appendChild(linha);
          const valorEl = linha.querySelector('.grupo-valor');
          linha.querySelector('.grupo-mais').addEventListener('click', () => {
            const v = Math.min(g.qtd_max, parseInt(valorEl.textContent, 10) + 1);
            valorEl.textContent = v;
          });
          linha.querySelector('.grupo-menos').addEventListener('click', () => {
            const v = Math.max(g.qtd_min, parseInt(valorEl.textContent, 10) - 1);
            valorEl.textContent = v;
          });
        } else {
          const inputType = g.tipo === 'multiple' ? 'checkbox' : 'radio';
          g.valores.forEach(v => {
            const linha = document.createElement('div');
            linha.className = 'opcao-valor-linha';
            const inputId = `opt-${g.id}-${v.id}`;
            linha.innerHTML = `
              <input type="${inputType}" name="grupo-${g.id}" id="${inputId}" value="${v.id}" style="width:auto; margin:0;">
              <label for="${inputId}">${v.nome}</label>
            `;
            div.appendChild(linha);
          });
        }

        cont.appendChild(div);
      });

      overlay.classList.add('aberto');
    }

    document.getElementById('modal-cancelar').addEventListener('click', () => overlay.classList.remove('aberto'));
    document.getElementById('modal-qtd-mais').addEventListener('click', () => {
      modalQtd++;
      document.getElementById('modal-qtd-valor').textContent = modalQtd;
    });
    document.getElementById('modal-qtd-menos').addEventListener('click', () => {
      modalQtd = Math.max(1, modalQtd - 1);
      document.getElementById('modal-qtd-valor').textContent = modalQtd;
    });

    document.getElementById('modal-confirmar').addEventListener('click', () => {
      const opcoesSelecionadas = {};
      const textoPartes = [];
      let faltaObrigatorio = null;

      document.querySelectorAll('#modal-grupos .grupo-opcao').forEach(div => {
        const grupoId = div.dataset.grupoId;
        const tipo = div.dataset.tipo;
        const grupoInfo = itemAtual.grupos.find(g => String(g.id) === grupoId);

        if (tipo === 'quantidade') {
          const valor = parseInt(div.querySelector('.grupo-valor').textContent, 10);
          opcoesSelecionadas[grupoId] = valor;
          if (grupoInfo.obrigatorio && valor <= 0) faltaObrigatorio = grupoInfo.nome;
          if (valor > 0) textoPartes.push(`${grupoInfo.nome}: ${valor}`);
        } else if (tipo === 'multiple') {
          const marcados = Array.from(div.querySelectorAll('input:checked')).map(i => i.value);
          opcoesSelecionadas[grupoId] = marcados;
          if (grupoInfo.obrigatorio && marcados.length === 0) faltaObrigatorio = grupoInfo.nome;
          if (marcados.length > 0) {
            const nomes = marcados.map(id => grupoInfo.valores.find(v => String(v.id) === id).nome);
            textoPartes.push(`${grupoInfo.nome}: ${nomes.join(', ')}`);
          }
        } else {
          const marcado = div.querySelector('input:checked');
          if (grupoInfo.obrigatorio && !marcado) faltaObrigatorio = grupoInfo.nome;
          if (marcado) {
            opcoesSelecionadas[grupoId] = marcado.value;
            const nomeVal = grupoInfo.valores.find(v => String(v.id) === marcado.value).nome;
            textoPartes.push(`${grupoInfo.nome}: ${nomeVal}`);
          }
        }
      });

      if (faltaObrigatorio) {
        alert(`Escolha uma opção em "${faltaObrigatorio}" antes de continuar.`);
        return;
      }

      const observacao = document.getElementById('modal-observacao').value.trim();

      opcoesCarrinho.push({
        uid: uidSeq++,
        item_id: itemAtual.id,
        nome_item: itemAtual.nome,
        quantidade: modalQtd,
        opcoes: opcoesSelecionadas,
        opcoesTextoDisplay: textoPartes.join(' | '),
        observacao
      });

      renderizarLinhasConfiguradas(itemAtual.id);
      overlay.classList.remove('aberto');
      atualizarBotaoEnviar();
    });

    function removerLinhaOpcao(uid) {
      const linha = opcoesCarrinho.find(x => x.uid === uid);
      const idx = opcoesCarrinho.findIndex(x => x.uid === uid);
      if (idx >= 0) opcoesCarrinho.splice(idx, 1);
      if (linha) {
        const card = document.querySelector(`[data-item-id="${linha.item_id}"]`);
        if (card) renderizarLinhasConfiguradas(linha.item_id);
      }
      atualizarBotaoEnviar();
    }

    function renderizarLinhasConfiguradas(itemId) {
      const card = document.querySelector(`[data-item-id="${itemId}"]`);
      const cont = card.querySelector('.linhas-configuradas');
      cont.innerHTML = '';
      opcoesCarrinho
        .filter(l => l.item_id === itemId)
        .forEach(l => {
          const div = document.createElement('div');
          div.className = 'linha-configurada';
          div.innerHTML = `
            <span>${l.quantidade}x ${l.opcoesTextoDisplay || 'sem opções'}${l.observacao ? ' — ' + l.observacao : ''}</span>
            <button type="button" class="remover">Remover</button>
          `;
          div.querySelector('.remover').addEventListener('click', () => removerLinhaOpcao(l.uid));
          cont.appendChild(div);
        });
    }

    // ---------- Tela do carrinho ----------
    function abrirCarrinho() {
      document.getElementById('tela-home').style.display = 'none';
      document.querySelectorAll('.tela-categoria').forEach(t => t.classList.remove('ativa'));
      document.getElementById('tela-carrinho').classList.add('aberta');
      document.getElementById('footer-home').style.display = 'none';
      document.getElementById('footer-carrinho').style.display = '';
      renderizarCarrinho();
      window.scrollTo(0, 0);
    }

    function fecharCarrinho() {
      document.getElementById('tela-carrinho').classList.remove('aberta');
      document.getElementById('tela-home').style.display = '';
      document.getElementById('footer-carrinho').style.display = 'none';
      document.getElementById('footer-home').style.display = '';
      window.scrollTo(0, 0);
    }

    function renderizarCarrinho() {
      const cont = document.getElementById('carrinho-linhas');
      cont.innerHTML = '';

      const linhas = [];
      Object.entries(simpleCarrinho).forEach(([itemId, qtd]) => {
        if (qtd > 0 && todosItensPorId[itemId]) {
          linhas.push({ tipo: 'simples', itemId, qtd, item: todosItensPorId[itemId] });
        }
      });
      opcoesCarrinho.forEach(l => {
        const item = todosItensPorId[l.item_id];
        if (item) linhas.push({ tipo: 'opcao', uid: l.uid, qtd: l.quantidade, item, linha: l });
      });

      if (linhas.length === 0) {
        cont.innerHTML = '<div class="carrinho-vazio">Seu carrinho está vazio.</div>';
        document.getElementById('carrinho-total-valor').textContent = formatarReais(0);
        return;
      }

      linhas.forEach(l => {
        const subtotal = l.item.preco * l.qtd;
        const div = document.createElement('div');
        div.className = 'linha-carrinho';
        const detalhe = l.tipo === 'opcao'
          ? [l.linha.opcoesTextoDisplay, l.linha.observacao].filter(Boolean).join(' — ')
          : '';
        div.innerHTML = `
          <div class="linha-carrinho-info">
            <div class="linha-carrinho-nome">${l.qtd}x ${l.item.nome}</div>
            ${detalhe ? `<div class="linha-carrinho-detalhe">${detalhe}</div>` : ''}
            <div class="linha-carrinho-valor">${formatarReais(subtotal)}</div>
          </div>
          <div class="linha-carrinho-acoes">
            <button type="button" class="linha-carrinho-remover">Remover</button>
          </div>
        `;
        div.querySelector('.linha-carrinho-remover').addEventListener('click', () => {
          if (l.tipo === 'simples') {
            simpleCarrinho[l.itemId] = 0;
            const card = document.querySelector(`[data-item-id="${l.itemId}"]`);
            const valorEl = card && card.querySelector('.qtd-valor');
            if (valorEl) valorEl.textContent = 0;
            atualizarBotaoEnviar();
          } else {
            removerLinhaOpcao(l.uid);
          }
        });
        cont.appendChild(div);
      });

      document.getElementById('carrinho-total-valor').textContent = formatarReais(valorTotalCarrinho());
    }

    document.getElementById('btn-ver-carrinho').addEventListener('click', abrirCarrinho);
    document.querySelectorAll('[data-fechar-carrinho]').forEach(btn => btn.addEventListener('click', fecharCarrinho));

    document.getElementById('btn-enviar').addEventListener('click', async () => {
      const itens = [];

      Object.entries(simpleCarrinho).forEach(([item_id, quantidade]) => {
        if (quantidade > 0) itens.push({ item_id: parseInt(item_id, 10), quantidade });
      });

      opcoesCarrinho.forEach(l => {
        itens.push({
          item_id: l.item_id,
          quantidade: l.quantidade,
          opcoes: l.opcoes,
          observacao: l.observacao
        });
      });

      if (itens.length === 0) return;

      const btn = document.getElementById('btn-enviar');
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      try {
        const resp = await fetch(`/pedido/${token}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itens })
        });
        const data = await resp.json();
        if (data.ok) {
          document.getElementById('app').innerHTML = `
            <div class="card" style="text-align:center; padding: 32px 16px;">
              <h2>Pedido enviado! ✅</h2>
              <p>Seu pedido (nº ${data.pedidoId}) foi enviado ao bar.</p>
              ${data.avisoImpressao ? `<p class="texto-erro">${data.avisoImpressao}</p>` : '<p>Aguarde, o garçom levará até a sua mesa.</p>'}
            </div>`;
          document.querySelectorAll('.footer-bar').forEach(el => (el.style.display = 'none'));
        } else {
          alert(data.erro || 'Não foi possível enviar o pedido.');
          btn.disabled = false;
          atualizarBotaoEnviar();
        }
      } catch (e) {
        alert('Erro de conexão. Verifique o wifi e tente novamente.');
        btn.disabled = false;
        atualizarBotaoEnviar();
      }
    });
  </script>
</body>
</html>
