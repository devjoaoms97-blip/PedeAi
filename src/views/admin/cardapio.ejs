<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Cardápio</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <nav class="admin-nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/mesas">Mesas</a>
      <a href="/admin/cardapio">Cardápio</a>
      <a href="/admin/pedidos">Pedidos</a>
      <a href="/admin/config">Configuração</a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <button type="submit" style="background:none;border:none;color:#fff;opacity:0.85;cursor:pointer;font-size:14px;">Sair</button>
      </form>
    </nav>
  </div>
  <div class="admin-container">
    <h2>Cardápio</h2>

    <div class="card">
      <h3>Nova categoria</h3>
      <form method="POST" action="/admin/cardapio/categorias/nova" enctype="multipart/form-data" class="form-inline">
        <div><input type="text" name="nome" placeholder="Ex: Bebidas, Porções..." required></div>
        <div>
          <label>Ícone (opcional, imagem quadrada)</label>
          <input type="file" name="imagem" accept="image/*">
        </div>
        <button class="btn-primario" style="width:auto; padding:10px 18px;" type="submit">Adicionar categoria</button>
      </form>
    </div>

    <div class="card">
      <h3>Novo item</h3>
      <form method="POST" action="/admin/cardapio/itens/novo" enctype="multipart/form-data">
        <label>Categoria</label>
        <select name="categoria_id" required>
          <% categorias.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.nome %></option>
          <% }) %>
        </select>
        <label>Nome do item</label>
        <input type="text" name="nome" required>
        <label>Descrição (opcional)</label>
        <input type="text" name="descricao">
        <label>Preço (R$)</label>
        <input type="text" name="preco" placeholder="Ex: 9,90" required>
        <label>Ícone (opcional, imagem quadrada)</label>
        <input type="file" name="imagem" accept="image/*">
        <button class="btn-primario" type="submit">Adicionar item</button>
      </form>
    </div>

    <% categorias.forEach(cat => { %>
      <h3 style="display:flex; align-items:center; gap:10px;">
        <% if (cat.imagem) { %><img src="<%= cat.imagem %>" style="width:32px;height:32px;border-radius:6px;object-fit:cover;"><% } %>
        <%= cat.nome %>
      </h3>
      <div class="card">
        <form method="POST" action="/admin/cardapio/categorias/<%= cat.id %>/editar" enctype="multipart/form-data" class="form-inline">
          <div><input type="text" name="nome" value="<%= cat.nome %>"></div>
          <div>
            <label>Trocar ícone</label>
            <input type="file" name="imagem" accept="image/*">
          </div>
          <button class="btn-secundario" type="submit">Salvar categoria</button>
          <% if (cat.imagem) { %>
            <button class="btn-secundario btn-mini btn-perigo" type="submit" formaction="/admin/cardapio/categorias/<%= cat.id %>/remover-imagem" formnovalidate>Remover ícone</button>
          <% } %>
        </form>
      </div>
      <% itens.filter(i => i.categoria_id === cat.id).forEach(item => { %>
        <div class="card">
          <form method="POST" action="/admin/cardapio/itens/<%= item.id %>/editar" enctype="multipart/form-data" class="form-inline">
            <% if (item.imagem) { %>
              <img src="<%= item.imagem %>" style="width:44px;height:44px;border-radius:8px;object-fit:cover;">
            <% } %>
            <div>
              <label>Nome</label>
              <input type="text" name="nome" value="<%= item.nome %>">
            </div>
            <div>
              <label>Descrição</label>
              <input type="text" name="descricao" value="<%= item.descricao %>">
            </div>
            <div style="max-width:110px;">
              <label>Preço</label>
              <input type="text" name="preco" value="<%= item.preco.toFixed(2) %>">
            </div>
            <div>
              <label>Trocar ícone</label>
              <input type="file" name="imagem" accept="image/*">
            </div>
            <button class="btn-secundario" type="submit">Salvar</button>
            <% if (item.imagem) { %>
              <button class="btn-secundario btn-mini btn-perigo" type="submit" formaction="/admin/cardapio/itens/<%= item.id %>/remover-imagem" formnovalidate>Remover ícone</button>
            <% } %>
          </form>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span class="badge <%= item.disponivel ? 'badge-ok' : 'badge-erro' %>">
              <%= item.disponivel ? 'Disponível' : 'Indisponível' %>
            </span>
            <div style="display:flex; gap:6px;">
              <a class="btn-secundario btn-mini" style="text-decoration:none; color:inherit;" href="/admin/cardapio/itens/<%= item.id %>/opcoes">Opções</a>
              <form method="POST" action="/admin/cardapio/itens/<%= item.id %>/toggle">
                <button class="btn-secundario btn-mini" type="submit">
                  <%= item.disponivel ? 'Marcar indisponível' : 'Marcar disponível' %>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% }) %>
  </div>
</body>
</html>
