<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Mesas</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <nav class="admin-nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/mesas">Mesas</a>
      <a href="/admin/cardapio">Cardápio</a>
      <a href="/admin/pedidos">Pedidos</a>
      <a href="/admin/config">Configuração</a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <button type="submit" style="background:none;border:none;color:#fff;opacity:0.85;cursor:pointer;font-size:14px;">Sair</button>
      </form>
    </nav>
  </div>
  <div class="admin-container">
    <h2>Mesas</h2>

    <% if (!baseUrl || baseUrl.includes('192.168.0.100')) { %>
      <div class="card" style="border-left:4px solid #e0a500;">
        ⚠️ Confira o <strong>endereço base</strong> em <a href="/admin/config">Configuração</a> — ele precisa ser o IP real deste computador na rede local para os QR codes funcionarem.
      </div>
    <% } %>

    <div class="card">
      <form method="POST" action="/admin/mesas/nova" class="form-inline">
        <div>
          <label>Nova mesa (nome)</label>
          <input type="text" name="nome" placeholder="Ex: Mesa 11" required>
        </div>
        <button class="btn-primario" style="width:auto; padding:10px 18px;" type="submit">Adicionar</button>
      </form>
    </div>

    <div class="card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
      <div>
        <button type="button" class="btn-secundario btn-mini" onclick="marcarTodas(true)">Marcar todas</button>
        <button type="button" class="btn-secundario btn-mini" onclick="marcarTodas(false)">Desmarcar todas</button>
      </div>
      <div style="display:flex; gap:8px;">
        <button type="submit" form="form-imprimir-selecionadas" class="btn-primario" style="width:auto; padding:10px 16px;">Imprimir selecionadas</button>
        <a href="/admin/mesas/imprimir?todas=1" class="btn-primario" style="width:auto; padding:10px 16px; text-decoration:none; display:inline-block;">Imprimir todas</a>
      </div>
    </div>

    <form id="form-imprimir-selecionadas" method="GET" action="/admin/mesas/imprimir" target="_blank"></form>

    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap:12px;">
      <% mesas.forEach(m => { %>
        <div class="card qr-box">
          <label style="display:flex; align-items:center; gap:6px; justify-content:center; margin-bottom:8px; font-size:13px;">
            <input type="checkbox" class="chk-mesa" form="form-imprimir-selecionadas" name="ids" value="<%= m.id %>" style="width:auto; margin:0;">
            Selecionar
          </label>

          <form method="POST" action="/admin/mesas/<%= m.id %>/renomear" style="margin-bottom:8px;">
            <input type="text" name="nome" value="<%= m.nome %>" style="text-align:center; font-weight:600; margin-bottom:6px;">
            <button class="btn-secundario btn-mini" type="submit">Salvar nome</button>
          </form>

          <img src="<%= m.qr %>" alt="QR code <%= m.nome %>">
          <div class="mesa-token">token: <%= m.token %></div>

          <div style="margin-top:10px; display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">
            <span class="badge <%= m.ativa ? 'badge-ok' : 'badge-erro' %>"><%= m.ativa ? 'Ativa' : 'Inativa' %></span>
          </div>

          <div style="margin-top:10px; display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">
            <a href="/admin/mesas/imprimir?ids=<%= m.id %>" target="_blank" class="btn-secundario btn-mini" style="text-decoration:none; color:inherit;">Imprimir</a>
            <form method="POST" action="/admin/mesas/<%= m.id %>/toggle">
              <button class="btn-secundario btn-mini" type="submit"><%= m.ativa ? 'Desativar' : 'Ativar' %></button>
            </form>
            <form method="POST" action="/admin/mesas/<%= m.id %>/rotacionar" onsubmit="return confirm('Isso invalida o QR impresso atual desta mesa. Continuar?');">
              <button class="btn-secundario btn-mini btn-perigo" type="submit">Gerar novo QR</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

    <script>
      function marcarTodas(valor) {
        document.querySelectorAll('.chk-mesa').forEach(c => (c.checked = valor));
      }
    </script>
  </div>
</body>
</html>
