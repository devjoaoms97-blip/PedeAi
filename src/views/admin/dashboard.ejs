<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/marca-estilo') %>
</head>
<body>
  <%- include('../partials/admin-topbar') %>
  <div class="admin-container">
    <h2>Visão geral</h2>
    <% if (pedidosComErro > 0) { %>
      <div class="alerta alerta-erro">
        <span><%= pedidosComErro %> pedido(s) com erro de impressão.</span>
        <a href="/admin/pedidos">Ver pedidos</a>
      </div>
    <% } %>
    <% if (senhaPadrao) { %>
      <div class="alerta alerta-erro">
        <span>Você entrou com a senha inicial (admin123).</span>
        <a href="/admin/minha-senha">Trocar senha</a>
      </div>
    <% } %>
    <% if (backup.erro || backup.atrasado) { %>
      <div class="alerta alerta-erro">
        <span><%= backup.erro ? 'O último backup falhou.' : 'Nenhum backup nas últimas 24 horas.' %></span>
        <a href="/admin/config#backup">Ver backup</a>
      </div>
    <% } else if (backup.usandoPastaPadrao) { %>
      <div class="alerta">
        <span>Os backups estão sendo salvos no próprio notebook. Escolha uma pasta na nuvem ou um pendrive.</span>
        <a href="/admin/config#backup">Configurar backup</a>
      </div>
    <% } %>
    <div class="kpis">
      <div class="card kpi">
        <span class="kpi-rotulo">Mesas ativas</span>
        <span class="kpi-valor"><%= totalMesas %></span>
      </div>
      <div class="card kpi">
        <span class="kpi-rotulo">Itens no cardápio</span>
        <span class="kpi-valor"><%= totalItens %></span>
      </div>
      <div class="card kpi">
        <span class="kpi-rotulo">Pedidos hoje</span>
        <span class="kpi-valor"><%= pedidosHoje %></span>
      </div>
    </div>
  </div>
</body>
</html>
