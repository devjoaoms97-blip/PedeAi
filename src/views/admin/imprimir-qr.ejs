<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Imprimir QR Codes das Mesas</title>
  <%- include('../partials/marca-estilo') %>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      margin: 0; background: #e9e9e9;
    }
    .barra-acoes {
      position: sticky; top: 0; background: #1f2023; color: #fff;
      padding: 12px 16px; display: flex; justify-content: space-between; align-items: center;
      z-index: 10;
    }
    .barra-acoes button {
      background: #fff; color: #1f2023; border: none; padding: 10px 18px;
      border-radius: 6px; font-weight: 600; cursor: pointer;
    }
    .folha {
      width: 210mm; min-height: 297mm; margin: 16px auto; background: #fff;
      padding: 10mm;
      display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;
      gap: 0;
    }
    /* Linha pontilhada = corte; a moldura colorida fica dentro, com a marca do restaurante */
    .cartao {
      border: 1px dashed #999;
      display: flex; align-items: center; justify-content: center;
      padding: 5mm;
    }
    .moldura {
      width: 100%; height: 100%;
      border: 2.5mm solid var(--cor-primaria); border-radius: 6mm;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 4mm;
    }
    .marca {
      display: flex; align-items: center; gap: 3mm; margin-bottom: 3mm;
    }
    .marca img.logo {
      width: 16mm; height: 16mm; border-radius: 50%; object-fit: cover;
    }
    .marca .nome-restaurante {
      font-size: 15pt; font-weight: 700; color: var(--cor-primaria);
    }
    .cartao img.qr { width: 68mm; height: 68mm; }
    .cartao .nome-mesa {
      font-size: 20pt; font-weight: 700; margin-top: 2mm; text-align: center;
      background: var(--cor-primaria); color: #fff; padding: 1mm 8mm; border-radius: 10mm;
    }
    .cartao .instrucao {
      font-size: 10pt; color: #555; margin-top: 2mm; text-align: center;
    }

    @media print {
      body { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .barra-acoes { display: none; }
      .folha { margin: 0; box-shadow: none; page-break-after: always; }
    }
  </style>
</head>
<body>
  <div class="barra-acoes">
    <span><%= mesas.length %> QR code(s) prontos para impressão · Folha A4 · 4 por página</span>
    <button onclick="window.print()">Imprimir</button>
  </div>

  <% for (let i = 0; i < mesas.length; i += 4) { %>
    <div class="folha">
      <% mesas.slice(i, i + 4).forEach(m => { %>
        <div class="cartao">
          <div class="moldura">
            <div class="marca">
              <img class="logo" src="<%= marca.logo %>" alt="Logo <%= marca.nome %>">
              <span class="nome-restaurante"><%= marca.nome %></span>
            </div>
            <img class="qr" src="<%= m.qr %>" alt="QR code <%= m.nome %>">
            <div class="nome-mesa"><%= m.nome %></div>
            <div class="instrucao">Aponte a câmera do celular para pedir</div>
          </div>
        </div>
      <% }) %>
      <% for (let j = mesas.slice(i, i + 4).length; j < 4; j++) { %>
        <div class="cartao" style="border-style: none;"></div>
      <% } %>
    </div>
  <% } %>
</body>
</html>
