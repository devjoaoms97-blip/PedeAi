<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Pedidos</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <nav class="admin-nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/mesas">Mesas</a>
      <a href="/admin/cardapio">Cardápio</a>
      <a href="/admin/pedidos">Pedidos</a>
      <a href="/admin/config">Configuração</a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <button type="submit" style="background:none;border:none;color:#fff;opacity:0.85;cursor:pointer;font-size:14px;">Sair</button>
      </form>
    </nav>
  </div>
  <div class="admin-container">
    <h2>Últimos pedidos</h2>
    <% pedidos.forEach(p => { %>
      <div class="card">
        <div style="display:flex; justify-content:space-between;">
          <strong>#<%= p.id %> · <%= p.mesa_nome %></strong>
          <span class="badge <%= p.impresso ? 'badge-ok' : 'badge-erro' %>">
            <%= p.impresso ? 'Impresso' : 'Não impresso' %>
          </span>
        </div>
        <div class="item-desc"><%= p.criado_em %></div>
        <ul>
          <% p.itens.forEach(it => { %>
            <li>
              <%= it.quantidade %>x <%= it.nome_item %>
              <% if (it.opcoes_texto) { %><br><span class="item-desc"><%= it.opcoes_texto %></span><% } %>
              <% if (it.observacao) { %><br><span class="item-desc">obs: <%= it.observacao %></span><% } %>
            </li>
          <% }) %>
        </ul>
        <% if (p.erro_impressao) { %>
          <div style="color:#b3261e; font-size:13px; margin-bottom:8px;">Erro: <%= p.erro_impressao %></div>
          <form method="POST" action="/admin/pedidos/<%= p.id %>/reimprimir">
            <button class="btn-secundario btn-mini" type="submit">Tentar reimprimir</button>
          </form>
        <% } %>
      </div>
    <% }) %>
    <% if (pedidos.length === 0) { %><p>Nenhum pedido ainda.</p><% } %>
  </div>
</body>
</html>
